# =============================================================================
# .gitattributes — GitHub Linguist hints (language stats, vendoring, diffs)
# =============================================================================
# Syntax notes:
#   - Patterns are gitignore-style; for a given path, the LAST matching line
#     wins. Put broad rules first, narrower exceptions after.
#   - linguist-vendored=true   exclude from the language bar and collapse in
#                              PR diffs (for code you didn't write).
#   - linguist-vendored=false  force-include a path Linguist would otherwise
#                              auto-vendor (e.g. it looks like a `packages/`
#                              folder), so it counts as this repo's own code.
#   - linguist-generated=true  machine-generated file; excluded from stats and
#                              hidden by default in diffs/reviews.
#   - linguist-language=Name   override language detection when Linguist
#                              guesses wrong, or can't guess at all.

# --- Third-party vendored code (William Howard's Sims2Tools) ---------------
# whoward69/Source_Code is a checkout of https://github.com/whoward69/Sims2Tools,
# reused under its Code Reuse Policy. Vendor the whole tree by default...
whoward69/Source_Code/** linguist-vendored=true

# ...except the GedcomExporter projects, which are this repo's own code and
# should count toward language stats and show up as normal diffs.
whoward69/Source_Code/GedcomExporter*/** linguist-vendored=false

# Build output is never "source", even inside our own projects — re-vendor it.
whoward69/Source_Code/GedcomExporter*/bin/** linguist-vendored=true
whoward69/Source_Code/GedcomExporter*/obj/** linguist-vendored=true

# WinForms designer files and assembly/settings/resource scaffolding are
# written by Visual Studio, not by hand — flag as generated even though they
# live in our own (non-vendored) projects.
whoward69/Source_Code/GedcomExporter*/**/*.Designer.cs linguist-generated=true
whoward69/Source_Code/GedcomExporter*/**/AssemblyInfo.cs linguist-generated=true

# --- Built release artifacts -------------------------------------------------
# The zipped-up beta build (DLLs/EXEs/configs) — a build product, not source.
beta_release/** linguist-vendored=true

# --- Game save data -----------------------------------------------------------
# Sample neighborhood data (Sims 2 .package saves, storytelling snapshots, a
# sample GEDCOM export) — not source code, shouldn't count toward language stats.
Neighborhood/** linguist-vendored=true

# GEDCOM isn't a language Linguist recognizes; treat it as plain text instead
# of letting it get miscategorized or silently dropped.
*.ged linguist-language=Text
